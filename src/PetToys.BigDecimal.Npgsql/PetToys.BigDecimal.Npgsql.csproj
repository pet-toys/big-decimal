<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Pinned so the Numerics/ folder lands in PetToys.BigDecimal.Numerics, where the type
         is. From any other namespace under PetToys.BigDecimal the identifier BigDecimal binds
         to the namespace instead - CS0118 at every mention, and a using alias does not fix it.
         It is also what keeps IDE0130 quiet. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>PostgreSQL helpers that map numeric columns to PetToys.BigDecimal.Core when reading and writing through Npgsql.</Description>
    <PackageTags>bigdecimal;decimal;numeric;postgresql;postgres;npgsql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
