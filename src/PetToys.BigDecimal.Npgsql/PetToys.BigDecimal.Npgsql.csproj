<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- The PostgreSQL mapping surface does not exist yet. Packing it would ship an
         assembly with no types in it, carrying a description that promises helpers
         and a hard dependency on the driver. The project stays in
         big-decimal.build.slnf so the release path keeps compiling it; set this
         back to true in the change that adds the first public type. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>PostgreSQL helpers that map numeric columns to PetToys.BigDecimal.Core when reading and writing through Npgsql.</Description>
    <PackageTags>bigdecimal;decimal;numeric;postgresql;postgres;npgsql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
