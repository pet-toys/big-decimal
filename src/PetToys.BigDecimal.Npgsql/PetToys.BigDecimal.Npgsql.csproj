<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Puts Numerics/ in PetToys.BigDecimal.Numerics, where the type is; from any other
         namespace under PetToys.BigDecimal the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>PostgreSQL helpers that map numeric columns to PetToys.BigDecimal.Core when reading and writing through Npgsql.</Description>
    <PackageTags>bigdecimal;decimal;numeric;postgresql;postgres;npgsql;aot;nativeaot;trimmable</PackageTags>
    <!-- A build gate over this assembly's own code. Npgsql 10.0.3 is itself marked trimmable,
         so the closure a consumer trims is clean; the aot workflow publishes and runs it. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
