<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Puts Numerics/ in PetToys.BigDecimal.Numerics, where the type is; from any other
         namespace under PetToys.BigDecimal the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>Dapper mapping that reads and writes ClickHouse Decimal32, Decimal64, Decimal128, and Decimal256 columns as PetToys.BigDecimal.Core values, over the formatter PetToys.BigDecimal.ClickHouse installs on the connection.</Description>
    <PackageTags>bigdecimal;decimal;clickhouse;dapper;numerics</PackageTags>
    <!-- A build gate over this assembly's own code, not a claim about the package: Dapper and
         ClickHouse.Driver both fail after a Native AOT publish. The README names both. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Dapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.ClickHouse\PetToys.BigDecimal.ClickHouse.csproj" />
  </ItemGroup>

</Project>
