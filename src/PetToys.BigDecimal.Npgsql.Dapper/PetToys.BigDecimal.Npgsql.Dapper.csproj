<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Puts Numerics/ in PetToys.BigDecimal.Numerics, where the type is; from any other
         namespace under PetToys.BigDecimal the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>Dapper mapping that reads and writes PostgreSQL numeric columns as PetToys.BigDecimal.Core values, over the handler PetToys.BigDecimal.Npgsql installs on the data source.</Description>
    <PackageTags>bigdecimal;decimal;numeric;postgresql;postgres;npgsql;dapper</PackageTags>
    <!-- A build gate over this assembly's own code, not a claim about the package: Dapper
         materialises reflectively and fails trimmed and Native AOT alike. The README says where. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Dapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Npgsql\PetToys.BigDecimal.Npgsql.csproj" />
  </ItemGroup>

</Project>
