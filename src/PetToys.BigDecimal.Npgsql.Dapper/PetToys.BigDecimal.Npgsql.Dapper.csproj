<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Pinned so the Numerics/ folder lands in PetToys.BigDecimal.Numerics, where the type
         is. From any other namespace under PetToys.BigDecimal the identifier BigDecimal binds
         to the namespace instead - CS0118 at every mention, and a using alias does not fix it. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>Dapper mapping that reads and writes PostgreSQL numeric columns as PetToys.BigDecimal.Core, over the handler PetToys.BigDecimal.Npgsql installs on the data source.</Description>
    <PackageTags>bigdecimal;decimal;numeric;postgresql;postgres;npgsql;dapper</PackageTags>
    <!-- Implies IsTrimmable and turns the trim, single-file and AOT analyzers into a build gate.
         It marks this assembly's own code and nothing else. Dapper generates its materialisers
         reflectively and fails under both publish modes, measured on 2026-09-10; the README says
         what fails and where, and this property is not a claim that the package works there. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Dapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <!-- The adapter installs the mapping this package reads and writes through. -->
    <ProjectReference Include="..\PetToys.BigDecimal.Npgsql\PetToys.BigDecimal.Npgsql.csproj" />
  </ItemGroup>

</Project>
