<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- The ClickHouse mapping surface does not exist yet. Packing it would ship an
         assembly with no types in it, carrying a description that promises helpers
         and a hard dependency on the driver. The project stays in
         big-decimal.build.slnf so the release path keeps compiling it; set this
         back to true in the change that adds the first public type. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>ClickHouse helpers that map Decimal32, Decimal64, Decimal128, and Decimal256 columns to PetToys.BigDecimal.Core when reading and writing through ClickHouse.Driver.</Description>
    <PackageTags>bigdecimal;decimal;clickhouse;numerics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
