<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Pinned so the Numerics/ folder lands in PetToys.BigDecimal.Numerics, where the type
         is. From any other namespace under PetToys.BigDecimal the identifier BigDecimal binds
         to the namespace instead - CS0118 at every mention, and a using alias does not fix it. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>ClickHouse helpers that map Decimal32, Decimal64, Decimal128, and Decimal256 columns to PetToys.BigDecimal.Core when reading and writing through ClickHouse.Driver.</Description>
    <PackageTags>bigdecimal;decimal;clickhouse;numerics;trimmable</PackageTags>
    <!-- Implies IsTrimmable and turns the trim, single-file and AOT analyzers into a build gate,
         since warnings are errors outside Debug. It marks this assembly and nothing else:
         ClickHouse.Driver 1.4.0 carries no IsTrimmable in either ClickHouse.Driver.dll or
         ClickHouse.Driver.Common.dll, so a consumer publishing trimmed or Native AOT is warned
         IL2104 over the driver whatever this package does. Leaving the property off would not
         spare them that warning, only cost this code its own gate; the README states the limit. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
