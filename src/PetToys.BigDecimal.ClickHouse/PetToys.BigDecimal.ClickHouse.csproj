<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- The type lives in PetToys.BigDecimal.Numerics, and from any namespace under
         PetToys.BigDecimal that does not hold it, the identifier BigDecimal binds to
         the namespace instead: every mention of the type is CS0118 and a using alias
         does not override it. Pinning the root namespace to PetToys.BigDecimal makes
         the Numerics/ folder come out as the namespace the type is in, the same way
         the core project, the Npgsql project and both test projects do it. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>ClickHouse helpers that map Decimal32, Decimal64, Decimal128, and Decimal256 columns to PetToys.BigDecimal.Core when reading and writing through ClickHouse.Driver.</Description>
    <PackageTags>bigdecimal;decimal;clickhouse;numerics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
