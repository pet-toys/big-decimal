<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Puts Numerics/ in PetToys.BigDecimal.Numerics, where the type is; from any other
         namespace under PetToys.BigDecimal the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>ClickHouse helpers that map Decimal32, Decimal64, Decimal128, and Decimal256 columns to PetToys.BigDecimal.Core when reading and writing through ClickHouse.Driver.</Description>
    <PackageTags>bigdecimal;decimal;clickhouse;numerics;trimmable</PackageTags>
    <!-- A build gate over this assembly's own code. ClickHouse.Driver 1.4.0 carries no
         IsTrimmable, so a trimmed consumer sees IL2104 over the driver whatever this says; the
         README states the limit. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
