<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Every framework compiles against EF Core 9, which also runs under EF Core 10; an
         assembly built against 10 cannot be consumed on 9. -->
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- Puts Numerics/ in PetToys.BigDecimal.Numerics, where the type is; from any other
         namespace under PetToys.BigDecimal the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>Entity Framework Core mapping that exposes PostgreSQL numeric columns as PetToys.BigDecimal.Core properties, over the handler PetToys.BigDecimal.Npgsql installs on the data source.</Description>
    <PackageTags>bigdecimal;decimal;numeric;postgresql;postgres;npgsql;efcore;entityframeworkcore</PackageTags>
    <!-- A build gate over this assembly's own code, not a claim about the closure: EF Core and
         its provider carry no IsTrimmable, and the README says what a trimmed consumer meets. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- For one type, NpgsqlDbContextOptionsBuilder; the rest compiles against Relational. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetToys.BigDecimal.Npgsql\PetToys.BigDecimal.Npgsql.csproj" />
  </ItemGroup>

</Project>
