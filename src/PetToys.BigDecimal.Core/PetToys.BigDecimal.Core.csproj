<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- The .Core suffix names the package, not the API: the types stay in
         PetToys.BigDecimal.Numerics, which the sibling packages share. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>A 256-bit decimal floating-point value type for .NET that represents the large PostgreSQL numeric and ClickHouse Decimal values .NET decimal cannot - allocation-free and exact to 77 significant digits.</Description>
    <PackageTags>bigdecimal;decimal;numeric;numerics;arbitrary-precision;postgresql;clickhouse;aot;nativeaot;trimmable</PackageTags>
    <!-- Implies IsTrimmable and turns the trim, single-file and AOT analyzers into a build gate,
         since warnings are errors outside Debug. Only the published projects carry it. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Core.Tests" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql" />
    <!-- The adapter suites and the benchmarks reach the wire codecs directly, so the bytes are
         checked and measured as they ship rather than through a copy that drifts. -->
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Tests" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Tests" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.Core.Benchmarks" />
  </ItemGroup>

</Project>
