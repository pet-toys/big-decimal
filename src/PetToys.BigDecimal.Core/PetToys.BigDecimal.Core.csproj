<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- The .Core suffix names the package, not the API: types stay in
         PetToys.BigDecimal.Numerics, which the sibling packages share. Pinning
         RootNamespace is also what keeps IDE0130 quiet. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>A 256-bit decimal floating-point value type for .NET that represents the large PostgreSQL numeric and ClickHouse Decimal values .NET decimal cannot - allocation-free and exact to 77 significant digits.</Description>
    <PackageTags>bigdecimal;decimal;numeric;numerics;arbitrary-precision;postgresql;clickhouse;aot;nativeaot;trimmable</PackageTags>
    <!-- Implies IsTrimmable and turns on the trim, single-file and AOT analyzers. Outside Debug
         warnings are errors, so this is a gate rather than a claim: a reflective path fails the
         build here instead of a consumer's publish. Only the published projects carry it - a test
         or benchmark assembly is never trimmed, and marking one would run three analyzers over
         code that decides nothing. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Core.Tests" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql" />
    <!-- The adapter test projects reach the codecs directly: a differential test against a
         live server checks the wire format itself, and should say so in terms of the wire
         rather than through whatever the handler exposes. -->
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse.Tests" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql.Tests" />
    <!-- The benchmarks are not a consumer: this is so the wire codecs are measured as they
         ship rather than as a copy that drifts. Copying a thirty-line division loop is cheap
         and honest, which is why DivisionPrimitiveBenchmarks does; two codecs are not. -->
    <InternalsVisibleTo Include="PetToys.BigDecimal.Core.Benchmarks" />
  </ItemGroup>

</Project>
