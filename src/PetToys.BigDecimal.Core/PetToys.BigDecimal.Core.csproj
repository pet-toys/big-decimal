<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <!-- The .Core suffix names the package, not the API. Types stay in
         PetToys.BigDecimal.Numerics so that the sibling integration packages
         and the namespace they share are unaffected by how this one is
         published; pinning RootNamespace is also what keeps IDE0130 quiet. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <Description>A 256-bit decimal floating-point value type for .NET that represents the large PostgreSQL numeric and ClickHouse Decimal values .NET decimal cannot - stack-only, allocation-free, and exact to 77 significant digits.</Description>
    <PackageTags>bigdecimal;decimal;numeric;numerics;arbitrary-precision;postgresql;clickhouse</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.BigDecimal.Core.Tests" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.ClickHouse" />
    <InternalsVisibleTo Include="PetToys.BigDecimal.Npgsql" />
    <!-- The benchmarks, unlike the three above, are not a consumer: they are here so that the
         wire codecs can be measured as they ship rather than as a copy. DivisionPrimitiveBenchmarks
         records the opposite call for its own case and it still holds there - copying a thirty-line
         division loop is cheap and honest. Copying two codecs is five hundred lines that drift, and
         the budget would then grade the copy. Measured cost of the attribute: 1024 bytes of
         metadata, carrying the assembly's own public key, so only something signed with this key
         can be the friend. -->
    <InternalsVisibleTo Include="PetToys.BigDecimal.Core.Benchmarks" />
  </ItemGroup>

</Project>
