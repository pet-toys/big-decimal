# EditorConfig is the single source of truth for code style and analyzer
# severity in this repository. Nested files -- under test/, and under bench/
# where a repository has one -- relax the rules that do not apply to code
# shipping no public API.
#
# The ruleset below is shared by every pet-toys package and hand-synced. The
# version tracks the ruleset itself, so a repository that has fallen behind is
# visible at a glance.
#
# VERSION 2.2

root = true

###############################################################################
# All files
###############################################################################

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

###############################################################################
# Markdown
###############################################################################

[*.md]

# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

###############################################################################
# MSBuild and XML files
###############################################################################

[*.{props,targets,csproj,slnx,xml,config}]
indent_size = 2

###############################################################################
# JSON files
#
# .slnf solution filters are JSON documents that carry no .json extension.
###############################################################################

[*.{json,slnf}]
indent_size = 2

###############################################################################
# C#
###############################################################################

[*.cs]

#------------------------------------------------------------------------------
# Style: using directives
#------------------------------------------------------------------------------

# Keep using directive groups together, with no separating blank line.
dotnet_separate_import_directive_groups = false

# Place System.* using directives before all others.
dotnet_sort_system_directives_first = true

# Never leave a blank line between using directives (RCS0015).
roslynator_blank_line_between_using_directives = never

#------------------------------------------------------------------------------
# Style: language constructs
#------------------------------------------------------------------------------

# Require braces around a statement that spans more than one line; a statement
# written on the same line as its keyword needs none (IDE0011).
csharp_prefer_braces = when_multiline

# Declare namespaces with a file-scoped declaration (IDE0161).
csharp_style_namespace_declarations = file_scoped

# Prefer a primary constructor where one fits (IDE0290).
csharp_style_prefer_primary_constructors = true

# Use var for locals whose type is not apparent (IDE0007).
csharp_style_var_elsewhere = true

# Use var for locals of a built-in type (IDE0007).
csharp_style_var_for_built_in_types = true

# Use var for locals whose type is apparent from the right-hand side (IDE0007).
csharp_style_var_when_type_is_apparent = true

# Use a collection expression only when the target type matches exactly.
dotnet_style_prefer_collection_expression = when_types_exactly_match

# Keep if/else assignment as it is, do not fold it into a conditional (IDE0045).
dotnet_style_prefer_conditional_expression_over_assignment = false

# Keep if/else return as it is, do not fold it into a conditional (IDE0046).
dotnet_style_prefer_conditional_expression_over_return = false

#------------------------------------------------------------------------------
# Style: whitespace
#------------------------------------------------------------------------------

# Put a space between a control flow keyword and its opening parenthesis.
csharp_space_after_keywords_in_control_flow_statements = true

# Keep the blank line after a file-scoped namespace declaration (RCS0060).
roslynator_blank_line_after_file_scoped_namespace_declaration = true

# Never separate switch sections with a blank line (RCS0061), a closing brace
# ahead of the next section included. This is what enforces what the old
# .globalconfig only declared through
# roslynator_blank_line_between_closing_brace_and_switch_section, which is an
# exception to a blank line otherwise required and does nothing under omit.
roslynator_blank_line_between_switch_sections = omit

# Require a newline at the end of a file (RCS0058).
roslynator_new_line_at_end_of_file = true

# Add a trailing comma only when the initializer spans multiple lines (RCS1260).
roslynator_trailing_comma_style = omit_when_single_line

#------------------------------------------------------------------------------
# Severity: code quality (CA)
#------------------------------------------------------------------------------

# CA1848: Use the LoggerMessage delegates -- reported as a suggestion.
dotnet_diagnostic.CA1848.severity = suggestion

# CA2007: Consider calling ConfigureAwait on the awaited task. Reusable library
# code must not capture the caller's SynchronizationContext, so every await
# needs ConfigureAwait(false). The rule is off by default at this analysis
# level; raise it to a warning. Release builds promote warnings to errors
# (TreatWarningsAsErrors), so a missing ConfigureAwait(false) fails CI. Test
# projects opt out in test/.editorconfig.
dotnet_diagnostic.CA2007.severity = warning

#------------------------------------------------------------------------------
# Severity: code style (IDE)
#------------------------------------------------------------------------------

# IDE0005: Remove unnecessary using directives.
dotnet_diagnostic.IDE0005.severity = warning

# IDE0007: Use var instead of explicit type.
dotnet_diagnostic.IDE0007.severity = warning

# IDE0011: Add braces. Enforces the csharp_prefer_braces policy above, which
# stayed a preference until a severity was assigned here.
dotnet_diagnostic.IDE0011.severity = warning

# IDE0021: Use expression body for constructors -- off, the author decides.
dotnet_diagnostic.IDE0021.severity = none

# IDE0022: Use expression body for methods -- off, the author decides.
dotnet_diagnostic.IDE0022.severity = none

# IDE0055: Fix formatting.
dotnet_diagnostic.IDE0055.severity = warning

# IDE0076: Invalid global SuppressMessageAttribute.
dotnet_diagnostic.IDE0076.severity = warning

# IDE0077: Avoid legacy format target in SuppressMessageAttribute.
dotnet_diagnostic.IDE0077.severity = warning

# IDE0079: Remove unnecessary suppression.
dotnet_diagnostic.IDE0079.severity = warning

# IDE0130: Namespace does not match folder structure.
dotnet_diagnostic.IDE0130.severity = warning

# IDE0161: Use file-scoped namespace.
dotnet_diagnostic.IDE0161.severity = warning

# IDE0290: Use primary constructor.
dotnet_diagnostic.IDE0290.severity = warning

# IDE0305: Simplify collection initialization -- off.
dotnet_diagnostic.IDE0305.severity = none

#------------------------------------------------------------------------------
# Severity: Roslynator (RCS)
#
# Every Roslynator rule listed below is disabled by default -- RCS1xxx no less
# than RCS00xx -- and runs only because a severity is assigned here. Deleting a
# line turns the rule off; it does not fall back to a default. The roslynator_*
# options above merely tune the rules that are enabled.
#
# Each line below is captioned with the rule's own title, verbatim, so it can be
# looked up against the Roslynator documentation. Several of those titles name a
# choice rather than a behaviour -- "Add/remove", "Normalize" -- and it is the
# roslynator_* option above that settles which way the rule goes. Where the two
# captions read differently for one rule, that is the reason: the title says
# what the rule governs, the option says what this repository chose.
#------------------------------------------------------------------------------

# RCS0003: Add blank line after using directive list.
dotnet_diagnostic.RCS0003.severity = warning

# RCS0008: Add blank line between closing brace and next statement.
dotnet_diagnostic.RCS0008.severity = warning

# RCS0010: Add blank line between declarations.
dotnet_diagnostic.RCS0010.severity = warning

# RCS0015: Add/remove blank line between using directives.
dotnet_diagnostic.RCS0015.severity = warning

# RCS0057: Normalize whitespace at the beginning of a file.
dotnet_diagnostic.RCS0057.severity = warning

# RCS0058: Normalize whitespace at the end of a file.
dotnet_diagnostic.RCS0058.severity = warning

# RCS0060: Add/remove line after file scoped namespace declaration.
dotnet_diagnostic.RCS0060.severity = warning

# RCS0061: Add/remove blank line between switch sections.
dotnet_diagnostic.RCS0061.severity = warning

# RCS0063: Remove unnecessary blank line.
dotnet_diagnostic.RCS0063.severity = warning

# RCS1060: Declare each type in separate file.
dotnet_diagnostic.RCS1060.severity = warning

# RCS1260: Add/remove trailing comma.
dotnet_diagnostic.RCS1260.severity = warning

# RCS1261: Resource can be disposed asynchronously.
dotnet_diagnostic.RCS1261.severity = warning

#------------------------------------------------------------------------------
# Severity: source generators (SYSLIB)
#------------------------------------------------------------------------------

# SYSLIB1006: Multiple logging methods cannot use the same event id within a class.
dotnet_diagnostic.SYSLIB1006.severity = warning
