<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Mirrors the namespace of the project under measurement: from any other namespace
         under PetToys.BigDecimal the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PetToys.BigDecimal.Core\PetToys.BigDecimal.Core.csproj" />
  </ItemGroup>

</Project>
