# Benchmark projects. Everything not listed here is inherited from the
# repository root; this file only relaxes what does not apply to code that
# ships no public API.

###############################################################################
# C#
###############################################################################

[*.cs]

#------------------------------------------------------------------------------
# Severity: compiler (CS)
#------------------------------------------------------------------------------

# CS1591: Missing XML comment for publicly visible type or member -- off.
# Benchmark projects publish no API, so they document none. BenchmarkDotNet
# requires public classes and public methods, and every one of them would
# otherwise demand an XML comment and fail the Release build under
# TreatWarningsAsErrors. GenerateDocumentationFile itself stays on: IDE0005 is
# only reported on build while a documentation file is being generated.
dotnet_diagnostic.CS1591.severity = none
