<Project>
  <PropertyGroup>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.0,9.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.0,10.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.0,11.0.0)</FrameworkExtVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.0,11.0.0)</FrameworkExtVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkExtVersion>
    <RoslynatorVersion>[5.0.0,)</RoslynatorVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Closed at the major: both adapters sit on an extension point the driver may reshape
         (Npgsql's is [Experimental("NPG9001")], ClickHouse.Driver passes IParameterFormatter its
         arguments in an undeclared order), and a closed range fails at restore rather than in a
         consumer at runtime. Each floor is the version the extension point was read from. -->
    <PackageVersion Include="ClickHouse.Driver" Version="[1.4.0,2.0.0)" />
    <PackageVersion Include="Npgsql" Version="[10.0.3,11.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Brackets the two majors measured working, 9.0.4 and 10.x. The 8.0.x provider restores
         against Npgsql 10.0.3 and throws TypeLoadException at first use. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[9.0.4,11.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Closed at the major over two shapes Dapper publishes without stating: ExecuteReader
         returning an IWrappedDataReader over the driver's reader, and DynamicParameters.Add
         keeping a parameter the statement names in the server's syntax. -->
    <PackageVersion Include="Dapper" Version="[2.1.79,3.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="$(RoslynatorVersion)" />
  </ItemGroup>
</Project>
