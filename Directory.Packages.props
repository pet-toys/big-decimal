<Project>
  <PropertyGroup>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.0,9.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.0,10.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.0,11.0.0)</FrameworkExtVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.0,11.0.0)</FrameworkExtVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkExtVersion>
    <RoslynatorVersion>[5.0.0,)</RoslynatorVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ClickHouse.Driver" Version="[1.4.0,)" />
    <!-- The Npgsql floor is not cosmetic. The adapter registers through
         Npgsql.Internal, which the driver publishes as [Experimental("NPG9001")]
         and reserves the right to reshape, so the floor has to be the version the
         registration API was read from and compiled against: 10.0.3, read on
         2026-09-09. The range stays open at the top per the fleet convention, and
         the consequence is accepted rather than hidden - a driver major can move
         the extension point, and the integration leg is what would find it. -->
    <PackageVersion Include="Npgsql" Version="[10.0.3,)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source Link is bundled in the .NET 8+ SDK; referencing the package
         explicitly suppresses the SDK's Source Link / deterministic source
         path target chain (no Source Link, non-deterministic PDB paths). -->
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="$(RoslynatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="$(RoslynatorVersion)" />
  </ItemGroup>
</Project>
