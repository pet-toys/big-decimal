<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The same pin the other suites carry: from any namespace under PetToys.BigDecimal that
         does not hold the type itself, the identifier BigDecimal binds to the namespace. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Testcontainers.ClickHouse" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PetToys.BigDecimal.ClickHouse.Dapper\PetToys.BigDecimal.ClickHouse.Dapper.csproj" />
    <!-- For the ClickHouseServer fixture, as a library. A second fixture would be a second pinned
         image digest to keep in step. xunit discovers tests in the assembly it runs, not in the
         ones it references, so the adapter suite does not run twice from here. -->
    <ProjectReference Include="..\PetToys.BigDecimal.ClickHouse.Tests\PetToys.BigDecimal.ClickHouse.Tests.csproj" />
  </ItemGroup>

</Project>
