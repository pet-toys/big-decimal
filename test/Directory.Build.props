<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Test projects publish no API, so they document none. GenerateDocumentationFile itself stays
    on: IDE0005 is only reported on build while a documentation file is being generated.
  -->
  <PropertyGroup Label="Documentation">
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
