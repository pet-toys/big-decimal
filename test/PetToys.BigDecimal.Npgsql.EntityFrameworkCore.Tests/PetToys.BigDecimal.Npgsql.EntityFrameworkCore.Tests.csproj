<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- From any other namespace under PetToys.BigDecimal the identifier BigDecimal binds to
         the namespace rather than the type. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <!-- VersionOverride: the root Directory.Packages.props already declares the library's range. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="$(EfCoreProviderVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The range this restore was asked for; EfCoreMajorTests compares it with what loaded. -->
    <AssemblyMetadata Include="EfCoreProviderVersion" Value="$(EfCoreProviderVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PetToys.BigDecimal.Npgsql.EntityFrameworkCore\PetToys.BigDecimal.Npgsql.EntityFrameworkCore.csproj" />
    <!-- For the PostgresServer fixture as a library; xunit discovers tests in the assembly it runs,
         so the adapter suite does not run twice from here. -->
    <ProjectReference Include="..\PetToys.BigDecimal.Npgsql.Tests\PetToys.BigDecimal.Npgsql.Tests.csproj" />
  </ItemGroup>

</Project>
