<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Mirrors the code under test: from any other namespace under PetToys.BigDecimal the
         identifier BigDecimal binds to the namespace rather than the type. -->
    <RootNamespace>PetToys.BigDecimal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers.ClickHouse" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PetToys.BigDecimal.ClickHouse\PetToys.BigDecimal.ClickHouse.csproj" />
    <!-- For the harness (WireFormatOracle, ValueGenerator) as a library. xunit discovers tests
         in the assembly it runs, so the core suite does not run twice from here. -->
    <ProjectReference Include="..\PetToys.BigDecimal.Core.Tests\PetToys.BigDecimal.Core.Tests.csproj" />
  </ItemGroup>

</Project>
