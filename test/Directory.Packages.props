<Project>
  <!--<Version>1.0</Version>-->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
  <PropertyGroup Label="The EF Core major the suite runs against">
    <!-- NuGet resolves a range to its floor, so integration.yml runs the suite a second time with
         EfCoreProviderFloor set to the 10.x floor. A floor rather than a range because a range
         carries a comma, and MSBuild splits -p: on commas whatever the shell quoting says. Two
         names, because -p: sets a global property and a project file cannot reassign one: a clamp
         written over the passed name would do nothing on exactly the run it exists for. The clamp
         is needed because the 10.x provider publishes net10.0 assets only (NU1202 elsewhere). -->
    <EfCoreProviderFloor Condition="'$(EfCoreProviderFloor)' == ''">9.0.4</EfCoreProviderFloor>
    <EfCoreProviderVersion>[$(EfCoreProviderFloor),11.0.0)</EfCoreProviderVersion>
    <EfCoreProviderVersion Condition="'$(TargetFramework)' != 'net10.0'">[9.0.4,10.0.0)</EfCoreProviderVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="[9.6.0,)" />
    <PackageVersion Include="Bogus" Version="[35.6.3,)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="[9.4.0,)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="[18.11.0,)" />
    <PackageVersion Include="Moq" Version="[4.20.72,)" />
    <PackageVersion Include="Testcontainers.ClickHouse" Version="[4.15.0,)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="[4.15.0,)" />
    <PackageVersion Include="xunit.v3" Version="[4.0.0,)" />
  </ItemGroup>
</Project>
